# soc.env - mediul serviciilor systemd de pe es-node-1 (EnvironmentFile=/home/tiberiu/lab/soc.env).
# Copiaza in soc.env (600) si completeaza CHANGE_ME. soc.env NU se comite (.gitignore).
# Lista e completa fata de `grep os.environ` din cod (faza 22 K); valorile sunt implicitele reale
# din cod, deci o linie comentata = implicitul. Cheile ES sunt scoped (fara delete/manage).
# SHADOW_MODE NU se pune aici: e fortat in ExecStart (deploy/soc-orchestrator.service).

# ---- comun: Elasticsearch / Kibana / model ---------------------------------------------------
ES_URL=http://localhost:9200
ES_API_KEY=CHANGE_ME                    # citire ingusta (logs-*, alerte, baseline, verdicts)
ES_READER_API_KEY=CHANGE_ME             # citire larga (si soc-metrics, soc-incidents)
# ES_READONLY_API_KEY=                   # optional: inlocuieste ES_API_KEY pentru clientii read-only
ES_WRITER_API_KEY=CHANGE_ME             # verdicts-history, soc-audit, soc-traces, soc-state, soc-cases
ES_CASES_WRITER_API_KEY=CHANGE_ME       # soc-cases (label_ui / cases.py)
ES_METRICS_WRITER_API_KEY=CHANGE_ME     # soc-metrics
ES_INCIDENTS_WRITER_API_KEY=CHANGE_ME   # soc-incidents (nday, static)
ES_VULNS_WRITER_API_KEY=CHANGE_ME       # asset-vulns
ES_STATIC_WRITER_API_KEY=CHANGE_ME      # static-findings
ES_FP_READER_API_KEY=CHANGE_ME          # fp_rate: benign-ground-truth + alerte
ES_MONITOR_API_KEY=CHANGE_ME            # absence_check: doar cluster:monitor
KIBANA_URL=http://localhost:5601
KIBANA_TIER3_API_KEY=CHANGE_ME          # spatiul tier3, eticheta tier3-generated
# KIBANA_TIER3_SPACE=tier3
# KIBANA_FLEET_API_KEY=                  # absence_check: starea agentilor (optional)
# FLEET_STATUS_URL=http://localhost:8220/api/status
OLLAMA_URL=http://localhost:11434/v1    # prin tunelul soc-llm-tunnel
# LLM_BASE_URL=                          # suprascrie OLLAMA_URL pentru toate rolurile
# MODEL_FAST=qwen3:14b                   # per rol: MODEL_<ROL>, LLM_BASE_URL_<ROL> (FAST, HUNT, HUNT_B, ...)
# LLM_SEED=20261102

# ---- orchestrator (soc-orchestrator) ---------------------------------------------------------
MONITORED_HOST=web-prod
# FAST_CONFIG=base                       # base in productie; A-D doar in ablatie
# FETCH_LIMIT=500
# SEEN_TTL_HOURS=24
# BACKLOG_THRESHOLD=20
# CASE_TIMEOUT_FAST_S=90
# CASE_TIMEOUT_HUNT_S=600
# ESC_LOW_CONF=90
# INTEGRITY_MAX_AGE_MIN=5
# FINDING_LOOKBACK_MIN=90
# GUIDES_DIR=/home/tiberiu/lab/detections
# RISK_THRESHOLD=20
# RISK_STATE=/home/tiberiu/lab/data/risk-state.json
# WP_SELF_IPS=192.168.10.138,172.30.6.249,127.0.0.1,::1   # IP-urile proprii ale web-prod
# BENIGN_GEN_IPS=192.168.10.150
# ADMIN_IPS=                             # readiness: IP-uri de administrare, niciodata blocate
# NEVER_BLOCK_IPS=                       # policy.is_protected: lista explicita, pe langa clasele private
# SOC_KILL_FILE=/etc/soc/KILL
# VERBOSE=                               # 1 = detalii pe stdout (harness, rulari manuale)

# ---- notificari (notify.py) -------------------------------------------------------------------
SOC_DISCORD_WEBHOOK=CHANGE_ME           # DOAR pe es-node-1, niciodata pe web-prod (R16)
# SOC_NOTIFY_STATE=/home/tiberiu/lab/data/notify-state.json

# ---- absenta si integritate (soc-absence, la 1 min) --------------------------------------------
# CANARY_HOST=web-prod
# ABSENCE_SERVICES=soc-orchestrator,soc-llm-tunnel
# ABSENCE_BACKUP_MAX_AGE_H=26
# ABSENCE_CANARY_MAX_AGE_MIN=12
# ABSENCE_CYCLE_MAX_AGE_MIN=15
# ABSENCE_PROBE_MAX_AGE_MIN=5
# ABSENCE_AGENT_CHECKIN_MAX_MIN=5
# ABSENCE_ES_DISK_MAX_PCT=80
# ABSENCE_ES_HEAP_MAX_PCT=90
# ABSENCE_SLOW_CYCLE_S=110
# ABSENCE_SLOW_COUNT=3
# ABSENCE_KEY_ROTATION_MAX_DAYS=95
SOC_KEYS_ROTATED_ON=2026-10-08          # data ultimei rotatii a cheilor (G8)
# ABSENCE_RESTORE_MAX_DAYS=35
# SOC_RESTORE_STAMP=/var/backups/web-prod/.restore-test-ok
# ABSENCE_SURICATA_RULES=0               # 1 = verifica si varsta regulilor Suricata
# ABSENCE_SURICATA_RULES_MAX_AGE_H=26
# INTEGRITY_CANARY_REF=/home/tiberiu/lab/data/canary.sha256
# INTEGRITY_CRON_STATE=/home/tiberiu/lab/data/cron.sha256
# INTEGRITY_HASH_EVERY_MIN=10

# ---- sonda modelului (soc-llm-probe) ---------------------------------------------------------
# LLM_PROBE_GEN_EVERY_MIN=5
# LLM_PROBE_STATE=/home/tiberiu/lab/data/llm_probe.json

# ---- Tier 3 / expunere / N-day / static / fp_rate / readiness --------------------------------
# WP_HOST=web-prod
# WP_VULNS_FEED=                         # exposure: fisier alternativ pentru kb/wp_vulns.yml
# THREAT_INTEL_FEED=                     # threat_intel: fisier alternativ pentru kb/threat_intel.yml
# COVERAGE_GAP_LIST=/home/tiberiu/lab/data/coverage/gap_list.json
# NDAY_HOST=web-prod
# NDAY_SBOM_INDEX=logs-soc.sbom-*
# NDAY_VULNS_INDEX=asset-vulns
# NDAY_INCIDENTS_INDEX=soc-incidents
# NDAY_METRICS_INDEX=soc-metrics
# NDAY_HUNT_MIN_CVSS=9.0
# NDAY_HUNT_MAX=10
# NDAY_HTTP_TIMEOUT=30
# NDAY_HTTP_RETRIES=3
# NDAY_OFFLINE=0
# NDAY_CACHE_DIR=/home/tiberiu/lab/data/nday-cache
# NDAY_WPSCAN_CACHE_TTL_S=86400
# NVD_API_KEY=                           # optional
# WPSCAN_API_KEY=                        # optional
# STATIC_HOST=web-prod
# STATIC_SNAPSHOT=/home/tiberiu/lab/data/static/webroot-snapshot
# STATIC_FINDINGS_INDEX=static-findings
# STATIC_INCIDENTS_INDEX=soc-incidents
# STATIC_METRICS_INDEX=soc-metrics
# STATIC_MAX_FINDINGS=200
# STATIC_MAX_MINUTES=60
# STATIC_USE_MODEL=0
# SEMGREP_BIN=/home/tiberiu/.local/bin/semgrep
# FP_HOURS=6
# FP_REPORT=/home/tiberiu/lab/data/fp_report.txt

# ---- soc-reader (gate read-only pe web-prod, pasul 1b) ---------------------------------------
# SOC_READER_TARGET=soc-reader@192.168.10.138
# SOC_READER_KEY=/home/tiberiu/.ssh/soc-reader

# ---- interfata de etichetare (label_ui, :8088) -----------------------------------------------
LABEL_UI_PASSWORD=CHANGE_ME
LABEL_UI_SECRET=CHANGE_ME               # cheia sesiunii (>= 32 de caractere aleatoare)
# LABEL_UI_HOST=192.168.10.121

# ---- harness / ablatie / regresie (rulate manual, nu de servicii) ----------------------------
# WEB_PROD_HOST=tiberiu@192.168.10.138   # tinta atacurilor de laborator (ssh cu sudo)
# SCENARIOS=scenarios.yml
# BWL_HOST=web-prod                      # build_whitelists: BWL_BASELINE_DAYS=7, BWL_MIN_DOC_COUNT=3,
#                                        #   BWL_TERMS_SIZE=200, BWL_PROC_INDEX / BWL_NET_INDEX
# COVERAGE_HOST=web-prod                 # coverage.py: COVERAGE_OUT=/home/tiberiu/lab/data/coverage
