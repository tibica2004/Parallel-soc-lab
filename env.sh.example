# Copiaza in env.sh si completeaza cheile. env.sh NU se comite (.gitignore).
# Mediul interactiv (`source env.sh`): venv + aceleasi variabile ca in soc.env (serviciile le citesc
# de acolo). Lista completa a variabilelor citite din cod, cu implicitele, e in soc.env.example;
# aici sunt cele de care ai nevoie de la tastatura. Adresele: es-net 192.168.10.0/24, flotantele
# 172.30.6.x (sesiunea de pe boxa veche atinge hosturile doar prin flotante).
source ~/lab/venv/bin/activate

# ---- Elasticsearch / Kibana (chei scoped, fara delete/manage) ----
export ES_URL=http://localhost:9200
export ES_API_KEY=CHANGE_ME             # citire ingusta
export ES_READER_API_KEY=CHANGE_ME      # citire larga (soc-metrics, soc-incidents)
export ES_WRITER_API_KEY=CHANGE_ME      # verdicts/audit/traces/state/cases; lipsa = dry-run, nu scrie
export ES_METRICS_WRITER_API_KEY=CHANGE_ME
export KIBANA_URL=http://localhost:5601
export KIBANA_TIER3_API_KEY=CHANGE_ME

# ---- model (prin tunelul soc-llm-tunnel) ----
export OLLAMA_URL=http://localhost:11434/v1
# export MODEL_FAST=qwen3:14b           # per rol: MODEL_<ROL>, LLM_BASE_URL_<ROL>

# ---- hosturi ----
export WEB_PROD_HOST=tiberiu@192.168.10.138       # harness/ablation: tinta atacurilor de laborator
export MONITORED_HOST=web-prod
# export WP_SELF_IPS=192.168.10.138,172.30.6.249,127.0.0.1,::1
# export BENIGN_GEN_IPS=192.168.10.150
# export NEVER_BLOCK_IPS=                          # pe langa clasele private (policy.is_protected)
# export SOC_READER_TARGET=soc-reader@192.168.10.138
# export LABEL_UI_HOST=192.168.10.121

# ---- interfata de etichetare ----
export LABEL_UI_PASSWORD=CHANGE_ME
export LABEL_UI_SECRET=CHANGE_ME

# ---- notificari (webhook de canal Discord). Secretul sta DOAR aici / in soc.env pe es-node-1,
# niciodata in repo sau pe web-prod (R16). ----
# export SOC_DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXXX/YYYY

# ---- rulari manuale ----
# export SHADOW_MODE=true               # implicit true; serviciul il forteaza in ExecStart
# export VERBOSE=1
# export FAST_CONFIG=base               # A-D doar pentru ablatie
# export SCENARIOS=scenarios_fast.yml
