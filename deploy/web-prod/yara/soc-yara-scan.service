[Unit]
Description=SOC: scanare YARA a webroot-ului (doar citire, raporteaza in jurnal)
# Rafalele de scrieri in webroot (deploy, harness) nu au voie sa blocheze unitatea .path.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/soc-yara-scan
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/soc-yara
StateDirectory=soc-yara
StateDirectoryMode=0700
