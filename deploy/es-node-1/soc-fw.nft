#!/usr/sbin/nft -f
# Firewall es-node-1 (pasul 0.3). Tabel PROPRIU (inet soc_fw): nu atinge tabelele
# Docker (ip/ip6 filter, nat) si nu se incarca prin nftables.service, al carui
# `flush ruleset` ar sterge si regulile Docker. Rollback = `nft delete table inet soc_fw`.
#
# 9200 si 5601 sunt publicate de Docker: traficul extern e DNAT-at in PREROUTING si
# trece prin FORWARD, nu prin INPUT. De aceea le filtreaza lantul forward_guard (drop-ul
# e definitiv intre tabele; accept-ul Docker nu il anuleaza). IPv6 pe [::]:9200/5601
# trece prin docker-proxy (INPUT), unde politica e drop.

# Idempotent: creeaza tabelul daca lipseste, apoi il inlocuieste integral.
table inet soc_fw
delete table inet soc_fw

table inet soc_fw {
    # Administrare (SSH, Kibana, interfata de etichetare): elastic-lab vechi + laptopul (Debian, Wi-Fi).
    # Laptopul are IP prin DHCP: daca se schimba, accesul direct se pierde (ramane elastic-lab).
    set admin_v4 {
        type ipv4_addr
        elements = { 172.20.99.220, 192.168.62.206 }
    }
    # Cine scrie direct in ES: Elastic Agent de pe web-prod (output Fleet) si benign-gen.
    set es_clients_v4 {
        type ipv4_addr
        elements = { 192.168.10.138, 192.168.10.150 }
    }

    chain input {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop
        meta l4proto icmp accept
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, packet-too-big, echo-request } accept
        udp sport 67 udp dport 68 accept
        # Containerele catre host (retelele Docker ale compose-ului).
        iifname "docker0" accept
        iifname "br-*" accept
        ip saddr @admin_v4 tcp dport { 22, 8088 } accept
        # Elastic Agent -> Fleet Server (doar din es-net).
        ip saddr 192.168.10.0/24 tcp dport 8220 accept
        limit rate 10/minute log prefix "soc-fw-drop " level info
    }

    chain forward_guard {
        type filter hook forward priority filter - 10; policy accept;
        iifname "ens3" ct state new tcp dport 9200 ip saddr != @es_clients_v4 drop
        iifname "ens3" ct state new tcp dport 5601 ip saddr != @admin_v4 drop
        iifname "ens3" ct state new meta nfproto ipv6 tcp dport { 9200, 5601 } drop
    }
}
