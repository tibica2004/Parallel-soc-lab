[Unit]
Description=Agentic SOC - absenta si integritate (3.D), la fiecare minut

[Timer]
# 3.D: la minut, ca pulsul integrity_check sa fie des (orchestratorul alerteaza la > 5 min).
OnCalendar=*:*:00
# Jitter mic: nu pornim exact la fix odata cu toate celelalte timere.
RandomizedDelaySec=10s
# Dupa o oprire a masinii, ruleaza o data la pornire in loc sa sara peste.
Persistent=true

[Install]
WantedBy=timers.target
