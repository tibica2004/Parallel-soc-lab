[Unit]
Description=Agentic SOC - readiness zilnic pentru block_ip_ttl (pasul 9; doar evaluare)
After=network-online.target docker.service

[Service]
Type=oneshot
User=tiberiu
WorkingDirectory=/home/tiberiu/lab
EnvironmentFile=/home/tiberiu/lab/soc.env
Environment=PYTHONUNBUFFERED=1
# Doar citire + soc-metrics type=readiness. Nu exista cale de executie (principiul 4).
ExecStart=/home/tiberiu/lab/venv/bin/python readiness.py
TimeoutStartSec=10min
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/home/tiberiu/lab/data
