[Unit]
Description=Agentic SOC - tunel SSH spre modelul Qwen3 (Ollama pe GPU)
After=network-online.target
Wants=network-online.target

[Service]
User=tiberiu
Environment=AUTOSSH_GATETIME=0
# -N fara comanda la distanta; fara -f: systemd tine procesul in prim-plan
ExecStart=/usr/bin/autossh -M 0 -N \
  -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes \
  -L 11434:localhost:11434 tiberiu@172.30.6.231
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
