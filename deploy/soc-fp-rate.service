[Unit]
Description=Agentic SOC - rata de fals pozitive per regula pe traficul benign (pasul 4)
After=network-online.target docker.service

[Service]
Type=oneshot
User=tiberiu
WorkingDirectory=/home/tiberiu/lab
EnvironmentFile=/home/tiberiu/lab/soc.env
Environment=PYTHONUNBUFFERED=1
# Doar citire de alerte + adevar benign; scrie soc-metrics type=fp_rate si data/fp_report.txt.
# Nu dezactiveaza si nu inchide nimic: regulile peste 5% sunt doar listate.
ExecStart=/home/tiberiu/lab/venv/bin/python fp_rate.py
TimeoutStartSec=10min
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/home/tiberiu/lab/data
