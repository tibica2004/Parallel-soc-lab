[Unit]
Description=Agentic SOC - faza 24: regresia pe setul de aur (doar cu sonda LLM sanatoasa)
After=network-online.target docker.service soc-llm-tunnel.service
Wants=network-online.target soc-llm-tunnel.service

[Service]
Type=oneshot
User=tiberiu
WorkingDirectory=/home/tiberiu/lab
EnvironmentFile=/home/tiberiu/lab/soc.env
Environment=PYTHONUNBUFFERED=1
# Foloseste GPU-ul partajat (Tier 1 pe setul de aur): ruleaza noaptea; daca sonda LLM nu e
# sanatoasa, sare (fara regresie trecuta, controlorul nu activeaza nimic).
ExecStart=/usr/bin/env SHADOW_MODE=true /home/tiberiu/lab/venv/bin/python tier3.py --once --regresie-aur --scrie --iesire data/tier3
TimeoutStartSec=120min
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/home/tiberiu/lab/data
