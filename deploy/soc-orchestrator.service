[Unit]
Description=Agentic SOC - orchestrator (SHADOW MODE)
After=network-online.target docker.service soc-llm-tunnel.service
Wants=network-online.target soc-llm-tunnel.service

[Service]
User=tiberiu
WorkingDirectory=/home/tiberiu/lab
EnvironmentFile=/home/tiberiu/lab/soc.env
Environment=PYTHONUNBUFFERED=1
# SHADOW fortat in comanda de pornire. ATENTIE: o linie Environment=SHADOW_MODE=true
# NU ar fi fost suficienta — variabilele din EnvironmentFile o suprascriu.
# `env` seteaza variabila chiar la executie, dupa ce fisierul a fost incarcat,
# deci nicio valoare din soc.env nu o poate schimba. Iesirea din shadow cere
# modificarea deliberata a acestei linii.
ExecStart=/usr/bin/env SHADOW_MODE=true /home/tiberiu/lab/venv/bin/python orchestrator.py --loop --interval 120 --sweep-every 30 --hunt-limit 5 --limit 50
Restart=on-failure
RestartSec=30
# Pasul 7 / G7. Watchdog: orchestratorul trimite WATCHDOG=1 (sdnotify.py) dupa fiecare alerta,
# investigatie si ciclu; fara semnal 15 min -> systemd il omoara si Restart=on-failure il
# reporneste. 900 s, nu 300: ciclurile masurate sub harness ajung la ~12 min.
NotifyAccess=main
WatchdogSec=900
# Varf masurat: 119 MB. Plafonul opreste o scurgere sa sufoce ES-ul de pe acelasi host.
MemoryMax=2G
NoNewPrivileges=yes
# Sistemul de fisiere read-only, cu exceptia data/ (singurul loc unde scrie: dedup-ul
# notificarilor). Verificat: niciun subprocess/ssh in modulele importate.
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/home/tiberiu/lab/data

[Install]
WantedBy=multi-user.target
