[Unit]
Description=Agentic SOC - faza 24: antrenare pe etichete umane + controlorul de activare (orar)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=tiberiu
WorkingDirectory=/home/tiberiu/lab
EnvironmentFile=/home/tiberiu/lab/soc.env
Environment=PYTHONUNBUFFERED=1
# Nu executa nimic pe hosturi; SHADOW_MODE fortat ca la celelalte servicii. Scrie doar in data/
# (data/models: artefacte + MANIFEST.json + audit.jsonl) si, prin chei scoped, in soc-metrics si
# soc-learning-audit. Fara model de limbaj.
ExecStart=/usr/bin/env SHADOW_MODE=true /home/tiberiu/lab/venv/bin/python tier3.py --once --invatare --scrie --iesire data/tier3
TimeoutStartSec=15min
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/home/tiberiu/lab/data
